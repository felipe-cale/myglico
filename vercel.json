{
  "buildCommand": "cd frontend-react && npm install && npm run build",
  "outputDirectory": "frontend-react/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/artifacts/:path*", "destination": "/api/index" },
    { "source": "/((?!api/|artifacts/|health$).*)", "destination": "/index.html" }
  ]
}
