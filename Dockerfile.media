FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
ENV PADDLE_PDX_MODEL_SOURCE=LOCAL
WORKDIR /app
COPY requirements-media.txt ./
RUN pip install --upgrade pip && pip install -r requirements-media.txt
COPY app ./app
EXPOSE 8010
# Secret and model paths are supplied by deployment; models must be mounted read-only.
CMD ["uvicorn", "app.media_worker.entrypoint:app", "--host", "0.0.0.0", "--port", "8010"]
